        new THREE.MeshBasicMaterial({ color: 0xff1e2d, side: THREE.DoubleSide, transparent: true, opacity: 0.55 })
      );
      ring.rotation.x = -Math.PI / 2;
      ring.position.set(ax, 0.08, az);
      scene.add(ring);
      artilleryStrikes.push({ x: ax, z: az, timer: 1.7 + i * 0.55, ring });
    }
  }

