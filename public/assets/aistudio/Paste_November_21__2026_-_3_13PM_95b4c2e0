    <div class="settings-row">
      <label>그래픽 품질:
        <select id="gfx-quality">
          <option value="ultra" selected>ULTRA (실시간 그림자 + 풀 이펙트)</option>
          <option value="high">HIGH (고프레임 최적화)</option>
        </select>
      </label>
      <label>마우스 감도:
        <input type="range" id="sens-slider" min="0.4" max="2.5" step="0.1" value="1.0">
        <span id="sens-val">1.0</span>
      </label>
