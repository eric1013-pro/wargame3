  function addBox(x, y, z, w, h, d, mat, opts = {}) {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    mesh.position.set(x, y + h / 2, z);
    mesh.castShadow = !opts.noShadow;
    mesh.receiveShadow = true;
    mesh.userData = { isWorld: true, surface: opts.surface || 'concrete', collider: null };
    scene.add(mesh);
    worldHitMeshes.push(mesh);

    const col = {
      minX: x - w/2, maxX: x + w/2,
      minZ: z - d/2, maxZ: z + d/2,
      height: y + h, mesh,
      destructible: !!opts.destructible,
      hp: opts.hp || 60, alive: true
    };
    mesh.userData.collider = col;
    if (!opts.noCollide) colliders.push(col);
    return col;
  }

