    yaw: 0, pitch: 0, onGround: true,
    hp: 100, maxHp: 100, armor: 100, maxArmor: 100,
    wpnIdx: 0, ammo: WEAPONS.map(w => w.mag),
    grenades: 3, nadeRegen: 0,
    fireCd: 0, reloadTimer: 0, ads: false,
    recoilPitch: 0, vmKickZ: 0, vmBob: 0,
    muzzleTimer: 0, bladeTimer: 0,
