  function addKillFeed(kFaction, kName, vFaction, vName, tag) {
    const kf = document.getElementById('kill-feed');
    const row = document.createElement('div');
    row.className = 'kf-row';
    const kc = kFaction === -1 ? 'c-art' : FACTION_INFO[kFaction].css;
    const vc = FACTION_INFO[vFaction].css;
    row.innerHTML = `<span class="${kc}">${kName}</span><span class="c-tag">[${tag}]</span><span class="${vc}">${vName}</span>`;
    kf.prepend(row);
    while (kf.children.length > 6) kf.lastChild.remove();
    setTimeout(() => { if (row.parentNode) row.remove(); }, 5500);
  }

  let calloutTimer = null;
  function showCenterCallout(text, color = '#ff2a4b') {
    const el = document.getElementById('center-callout');
    el.style.color = color;
    el.textContent = text;
    el.style.opacity = '1';
    clearTimeout(calloutTimer);
    calloutTimer = setTimeout(() => el.style.opacity = '0', 950);
  }

  let hmTimer = null;
  function triggerHitmarker(crit = false) {
    const hm = document.getElementById('hitmarker');
    hm.style.setProperty('--hm-color', crit ? '#ff1e42' : '#ffffff');
    hm.style.opacity = '1';
    hm.style.transform = `translate(-50%, -50%) scale(${crit ? 1.35 : 1.0})`;
    clearTimeout(hmTimer);
    hmTimer = setTimeout(() => {
      hm.style.opacity = '0';
      hm.style.transform = 'translate(-50%, -50%) scale(0.8)';
    }, 115);
  }

  function damagePlayer(amount, sourcePos, killerName) {
    if (!player.alive) return;
    if (player.armor > 0) {
      const abs = Math.min(player.armor, amount * 0.65);
      player.armor -= abs;
      amount -= abs;
    }
    player.hp = Math.max(0, player.hp - amount);
    state.shake = Math.max(state.shake, 0.28);

    // Damage screen flash
    const ov = document.getElementById('damage-overlay');
    ov.style.opacity = '0.85';
    setTimeout(() => ov.style.opacity = '0', 120);

    // CoD-style Directional Damage Indicator!
    if (sourcePos) {
      const dx = sourcePos.x - player.x;
      const dz = sourcePos.z - player.z;
      const worldAng = Math.atan2(dx, dz);
      // Forward camera direction in XZ is (-sin(yaw), -cos(yaw))
      const rel = Math.atan2(dx, dz) - (player.yaw + Math.PI);
      const deg = (-rel * 180 / Math.PI);
      const arc = document.getElementById('dmg-arc');
      arc.style.transform = `rotate(${deg}deg)`;
      arc.style.opacity = '1';
      clearTimeout(arc._t);
      arc._t = setTimeout(() => arc.style.opacity = '0', 450);
    }

    if (player.hp <= 0) {
      player.alive = false;
      state.dead = true;
      document.exitPointerLock();
      document.getElementById('death-msg').innerHTML = `최종 사인: <b style="color:#ff4757">${killerName}</b>의 공격으로 전사`;
      document.getElementById('st-time').textContent = fmtTime(state.time);
      document.getElementById('st-kills').textContent = state.kills;
      document.getElementById('st-dism').textContent = state.dismembers;
      document.getElementById('st-exec').textContent = state.executions;
      document.getElementById('death-screen').style.display = 'flex';
    }
  }

  function damageUnit(u, dmg, partName, hitPoint, hitDir, srcFaction, srcName, verb, customImpulse = null) {
    if (!u.alive) return;
    let finalDmg = dmg;
    let isCrit = false;
    let dismembered = false;

    if (partName === 'head') {
      finalDmg *= 2.45;
      isCrit = true;
    }

    u.hp -= finalDmg;
    u.hitFlash = 0.09;

    // Blood / Spark burst at exact 3D hit point + Wall/Floor decal behind target!
    spawn3DParticles(hitPoint, u.isRobot ? 'spark' : 'blood', isCrit ? 20 : 11, isCrit ? 7.5 : 5);
    projectSplatterDecal(hitPoint, hitDir, u.isRobot, isCrit ? 1.85 : 1.15);

    // Check Part Dismemberment!
    const wPower = srcFaction === FACTION.PLAYER ? WEAPONS[player.wpnIdx].dismemberPower : 0.4;
    if (partName !== 'torso' && !u.missing[partName]) {
      const shouldSever =
        (partName === 'head' && (u.hp <= 0 || wPower >= 1.4)) ||
        (partName !== 'head' && (finalDmg * wPower >= 38 || u.hp <= 0 && wPower >= 1.2));
      if (shouldSever) {
        dismembered = dismemberPart(u, partName, hitDir, wPower);
        if (partName === 'head' && !u.isBoss) u.hp = 0; // Decapitation is instant fatal!
        if ((partName === 'leftLeg' || partName === 'rightLeg') && !u.isBoss) u.hp = Math.min(u.hp, 0);
      }
    }

    if (srcFaction === FACTION.PLAYER) {
      triggerHitmarker(isCrit || dismembered || u.hp <= 0);
      SFX.playHitMarker(isCrit || u.hp <= 0, dismembered);
      if (dismembered) {
        state.hitstop = 0.055; // Visceral DOOM-style Hitstop!
        const partKR = { head: '두부 파괴 (HEADSHOT)', leftArm: '왼팔 절단', rightArm: '오른팔 절단', leftLeg: '왼다리 파괴', rightLeg: '오른다리 파괴' }[partName] || '부위 파괴';
        showCenterCallout(`☠ ${partKR}`, '#ff2a4b');
      }
    }

    if (u.hp <= 0) {
      u.alive = false;
      scene.remove(u.root);
      rebuildHitMeshCache();

      // Convert killed unit into a live multi-joint 3D RAGDOLL!
      const impulse = customImpulse || hitDir.clone().multiplyScalar(5 + wPower * 7.5);
      spawnRagdoll(u, impulse);

      if (u.isRobot && u.isBoss) {
        triggerExplosion(new THREE.Vector3(u.x, 1.5, u.z), 10, 120, srcFaction, u.name, false);
      }

      const finalTag = dismembered
        ? (partName === 'head' ? '헤드샷 · 두부 파괴' : '사지 절단')
        : verb;
      addKillFeed(srcFaction, srcName, u.faction, u.name, finalTag);

      if (srcFaction === FACTION.PLAYER) {
        state.kills++;
        if (state.kills % 12 === 0) state.wave++;
        if (isCrit || dismembered) state.hitstop = 0.068;
      }
    }
  }

  // DOOM-style Glory Kill Execution (`E` key on nearby weakened/staggered enemy)
  function findGloryKillTarget() {
    let best = null, bestD = 4.6;
    const camDir = new THREE.Vector3();
    camera.getWorldDirection(camDir);
    for (let i = 0; i < units.length; i++) {
      const u = units[i];
      if (!u.alive || u.isBoss) continue;
      if (u.hp > u.maxHp * 0.55 && u.staggerTimer <= 0) continue;
      const toU = new THREE.Vector3(u.x - player.x, 1.1 - player.y, u.z - player.z);
      const d = toU.length();
      if (d < bestD && toU.normalize().dot(camDir) > 0.65) {
        bestD = d; best = u;
      }
    }
    return best;
  }

  function performGloryKill() {
    const target = findGloryKillTarget();
    if (!target) return;

    // Lunge close to target
    const dir = new THREE.Vector3(target.x - player.x, 0, target.z - player.z).normalize();
    player.x = target.x - dir.x * 1.45;
    player.z = target.z - dir.z * 1.45;
    player.bladeTimer = 0.24;

    SFX.playGloryKill();
    state.hitstop = 0.095; // Heavy brutal execution freeze-frame!
    state.shake = 0.65;
    state.executions++;

    // Rip off multiple limbs & launch ragdoll violently
    dismemberPart(target, 'head', dir, 2.0);
    dismemberPart(target, 'rightArm', dir, 1.5);
    damageUnit(target, target.hp + 999, 'head', new THREE.Vector3(target.x, 1.4, target.z), dir, FACTION.PLAYER, '용병(나)', '글로리 킬 처형', dir.clone().multiplyScalar(16).add(new THREE.Vector3(0, 6, 0)));

    // Refill Health & Armor!
    player.hp = Math.min(player.maxHp, player.hp + 32);
    player.armor = Math.min(player.maxArmor, player.armor + 25);
    showCenterCallout('⚡ GLORY KILL EXECUTION // +HP +ARMOR', '#ff9f43');
  }

  // =========================================================================
  // 9. WEAPON FIRING & GRENADES
  // =========================================================================
  const shootRay = new THREE.Raycaster();
  function firePlayerWeapon() {
    if (player.reloadTimer > 0 || player.fireCd > 0) return;
    const w = WEAPONS[player.wpnIdx];
    if (player.ammo[player.wpnIdx] <= 0) { startReload(); return; }

    player.ammo[player.wpnIdx]--;
    player.fireCd = w.fireRate;
    player.recoilPitch += w.recoil * (player.ads ? 0.65 : 1.0);
    player.vmKickZ = Math.min(0.24, player.vmKickZ + (w.id === 0 ? 0.08 : 0.22));
    player.muzzleTimer = 0.055;
    state.shake = Math.max(state.shake, w.shake);

    SFX.playWeapon(w.sound, 1.0);
    if (w.id === 0 || w.id === 1) SFX.playShellClink();

    const origin = camera.position.clone();
    const baseDir = new THREE.Vector3();
    camera.getWorldDirection(baseDir);
    const muzzlePos = new THREE.Vector3(player.ads ? 0 : 0.22, -0.14, -0.85).applyMatrix4(camera.matrixWorld);

    // Rocket Launcher fires a physical smoking warhead!
    if (w.projectile === 'rocket') {
      const rMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.07, 0.55, 8), new THREE.MeshBasicMaterial({ color: 0xff6b35 }));
      rMesh.position.copy(muzzlePos);
      rMesh.lookAt(muzzlePos.clone().add(baseDir));
      rMesh.rotateX(Math.PI / 2);
      scene.add(rMesh);
      rockets.push({ mesh: rMesh, pos: muzzlePos.clone(), dir: baseDir.clone(), speed: 44, life: 4.0 });
      if (player.ammo[player.wpnIdx] <= 0) startReload();
      return;
    }

    const spread = player.ads ? w.adsSpread : w.spread;
    for (let p = 0; p < w.pellets; p++) {
      const dir = baseDir.clone();
      dir.x += (Math.random() - 0.5) * spread * 2;
      dir.y += (Math.random() - 0.5) * spread * 2;
      dir.z += (Math.random() - 0.5) * spread * 2;
      dir.normalize();

      shootRay.set(origin, dir);
      shootRay.far = 140;

      const worldHits = shootRay.intersectObjects(worldHitMeshes, false);
      const maxDist = worldHits.length > 0 ? worldHits[0].distance : 140;
      let endPoint = origin.clone().addScaledVector(dir, maxDist);

      const enemyHits = shootRay.intersectObjects(enemyHitMeshes, false);

      if (w.pierce) {
        // Railgun pierces through EVERY enemy in a straight line!
        const hitIds = new Set();
        for (const eh of enemyHits) {
          if (eh.distance > maxDist) break;
          const u = eh.object.userData.unit;
          if (!u || !u.alive || hitIds.has(u.id)) continue;
          hitIds.add(u.id);
          damageUnit(u, w.dmg, eh.object.userData.part, eh.point, dir, FACTION.PLAYER, '용병(나)', '레일건 관통');
        }
      } else if (enemyHits.length > 0 && enemyHits[0].distance < maxDist) {
        const eh = enemyHits[0];
        endPoint = eh.point;
        const u = eh.object.userData.unit;
        if (u && u.alive) {
          damageUnit(u, w.dmg, eh.object.userData.part, eh.point, dir, FACTION.PLAYER, '용병(나)', w.id === 1 ? '산탄 분쇄' : '사살');
        }
      } else if (worldHits.length > 0) {
        const wh = worldHits[0];
        const ud = wh.object.userData;
        if (ud.barrel && ud.barrel.alive) {
          ud.barrel.hp -= w.dmg;
          spawn3DParticles(wh.point, 'spark', 8, 6);
          if (ud.barrel.hp <= 0) {
            ud.barrel.alive = false;
            scene.remove(ud.barrel.mesh);
            const wi = worldHitMeshes.indexOf(ud.barrel.mesh);
            if (wi !== -1) worldHitMeshes.splice(wi, 1);
            triggerExplosion(new THREE.Vector3(ud.barrel.x, 0.8, ud.barrel.z), 10.5, 175, FACTION.PLAYER, '폭발 드럼통', false);
          }
        } else if (ud.collider && ud.collider.destructible && ud.collider.alive) {
          ud.collider.hp -= w.dmg;
          spawn3DParticles(wh.point, 'concrete', 7, 5);
          if (ud.collider.hp <= 0) destroyCrate(ud.collider, origin);
        } else if (wh.face) {
          const norm = wh.face.normal.clone().transformDirection(wh.object.matrixWorld).normalize();
          spawnDecal(wh.point, norm, 'bullet', w.id === 1 ? 0.24 : 0.28);
          spawn3DParticles(wh.point, 'concrete', 5, 4.5);
          spawn3DParticles(wh.point, 'spark', 3, 5.5);
        }
      }

      if (w.pierce || Math.random() < 0.65) {
        spawnTracer(muzzlePos, endPoint, w.color, w.pierce ? 0.24 : 0.065);
      }
    }

    if (player.ammo[player.wpnIdx] <= 0) startReload();
  }

  function startReload() {
    const w = WEAPONS[player.wpnIdx];
    if (player.reloadTimer > 0 || player.ammo[player.wpnIdx] === w.mag) return;
    player.reloadTimer = w.reload;
    SFX.playReload();
  }

  function throwGrenade() {
    if (player.grenades <= 0) return;
    player.grenades--;
    const dir = new THREE.Vector3();
    camera.getWorldDirection(dir);
    const mesh = new THREE.Mesh(new THREE.SphereGeometry(0.14, 10, 8), new THREE.MeshStandardMaterial({ color: 0x3f6212, roughness: 0.6 }));
    const pos = camera.position.clone().addScaledVector(dir, 0.8);
    mesh.position.copy(pos);
    scene.add(mesh);
    grenades.push({
      mesh, pos,
      vx: dir.x * 20, vy: dir.y * 16 + 5.5, vz: dir.z * 20,
      fuse: 1.55
    });
  }

  // =========================================================================
  // 10. COLLISION HELPERS & 3-WAY WAR AI LOOP
  // =========================================================================
  function resolveXZColliders(ent, r) {
    const lim = ARENA - 1.5 - r;
    ent.x = Math.max(-lim, Math.min(lim, ent.x));
    ent.z = Math.max(-lim, Math.min(lim, ent.z));
    for (let i = 0; i < colliders.length; i++) {
      const c = colliders[i];
      if (!c.alive) continue;
      if (ent.x > c.minX - r && ent.x < c.maxX + r && ent.z > c.minZ - r && ent.z < c.maxZ + r) {
        const dl = Math.abs(ent.x - (c.minX - r));
        const dr = Math.abs((c.maxX + r) - ent.x);
        const dt = Math.abs(ent.z - (c.minZ - r));
        const db = Math.abs((c.maxZ + r) - ent.z);
        const m = Math.min(dl, dr, dt, db);
        if (m === dl) ent.x = c.minX - r;
        else if (m === dr) ent.x = c.maxX + r;
        else if (m === dt) ent.z = c.minZ - r;
        else ent.z = c.maxZ + r;
      }
    }
  }

  const aiRay = new THREE.Raycaster();
  function hasLineOfSight3D(p1, p2) {
    const dir = p2.clone().sub(p1);
    const dist = dir.length();
    if (dist < 0.5) return true;
    aiRay.set(p1, dir.normalize());
    aiRay.far = dist - 0.4;
    return aiRay.intersectObjects(worldHitMeshes, false).length === 0;
  }

  function findSpawnPoint() {
    for (let t = 0; t < 20; t++) {
      const ang = Math.random() * Math.PI * 2;
      const dist = 20 + Math.random() * 28;
      const x = Math.max(-ARENA + 4, Math.min(ARENA - 4, player.x + Math.cos(ang) * dist));
      const z = Math.max(-ARENA + 4, Math.min(ARENA - 4, player.z + Math.sin(ang) * dist));
      let blocked = false;
      for (const c of colliders) {
        if (c.alive && x > c.minX - 1.5 && x < c.maxX + 1.5 && z > c.minZ - 1.5 && z < c.maxZ + 1.5) { blocked = true; break; }
      }
      if (!blocked) return { x, z };
    }
    return { x: 0, z: -38 };
  }

  function updateEnemies(dt) {
    for (let i = units.length - 1; i >= 0; i--) {
      const u = units[i];
      if (!u.alive) { units.splice(i, 1); continue; }

      // Hit flash recovery
      if (u.hitFlash > 0) {
        u.hitFlash -= dt;
        const em = u.hitFlash > 0 ? 0x661111 : 0x000000;
        for (const m of u.mats) m.emissive.setHex(em);
      }

      // Staggered animation (when arm blown off!)
      if (u.staggerTimer > 0) {
        u.staggerTimer -= dt;
        u.parts.torso.rotation.z = Math.sin(state.time * 22) * 0.25;
        if (Math.random() < 0.25) spawn3DParticles(new THREE.Vector3(u.x, 1.2*u.scale, u.z), u.isRobot ? 'spark' : 'blood', 1, 2.5);
        continue;
      } else {
        u.parts.torso.rotation.z = 0;
      }

      // Pick nearest enemy of ANY rival faction (3-way chaotic battlefield!)
      let target = null, bestD = Infinity;
      if (player.alive) {
        const dp = Math.hypot(player.x - u.x, player.z - u.z);
        target = { x: player.x, y: player.y - 0.3, z: player.z, isPlayer: true };
        bestD = dp * 1.05;
      }
      for (let j = 0; j < units.length; j++) {
        const o = units[j];
        if (!o.alive || o.faction === u.faction) continue;
        const d = Math.hypot(o.x - u.x, o.z - u.z);
        if (d < bestD) { bestD = d; target = o; }
      }

      if (target) {
        const dx = target.x - u.x, dz = target.z - u.z;
        const d = Math.hypot(dx, dz) || 1;
        const desiredYaw = Math.atan2(dx, dz);
        let diff = Math.atan2(Math.sin(desiredYaw - u.yaw), Math.cos(desiredYaw - u.yaw));
        u.yaw += diff * Math.min(1, dt * 8);
        u.root.rotation.y = u.yaw;

        const eyePos = new THREE.Vector3(u.x, 1.45 * u.scale, u.z);
        const tgtPos = new THREE.Vector3(target.x, target.isPlayer ? player.y - 0.3 : 1.2 * target.scale, target.z);
        const canSee = d < 42 && hasLineOfSight3D(eyePos, tgtPos);

        u.strafeCd -= dt;
        if (u.strafeCd <= 0) { u.strafeCd = 1.2 + Math.random()*2; u.strafeDir = -u.strafeDir; }

        let mx = 0, mz = 0;
        const idealDist = u.faction === FACTION.RAIDER ? 9 : 16;
        if (!canSee || d > idealDist) {
          mx = dx / d; mz = dz / d;
          if (!canSee) { mx += (-dz / d) * 0.7 * u.strafeDir; mz += (dx / d) * 0.7 * u.strafeDir; }
        } else {
          mx = (-dz / d) * 0.75 * u.strafeDir;
          mz = (dx / d) * 0.75 * u.strafeDir;
        }

        // Unit separation
        for (let j = 0; j < units.length; j++) {
          if (i === j || !units[j].alive) continue;
          const sx = u.x - units[j].x, sz = u.z - units[j].z;
          const sd = Math.hypot(sx, sz);
          if (sd > 0.01 && sd < u.r + units[j].r + 0.5) { mx += sx / sd; mz += sz / sd; }
        }

        const ml = Math.hypot(mx, mz) || 1;
        u.x += (mx / ml) * u.speed * dt;
        u.z += (mz / ml) * u.speed * dt;
        resolveXZColliders(u, u.r);
        u.root.position.set(u.x, 0, u.z);

        // Procedural running limb animation
        u.walkPhase += dt * u.speed * 2.1;
        const sw = Math.sin(u.walkPhase) * 0.65;
        if (u.parts.leftLeg)  u.parts.leftLeg.rotation.x = sw;
        if (u.parts.rightLeg) u.parts.rightLeg.rotation.x = -sw;
        if (u.parts.leftArm)  u.parts.leftArm.rotation.x = -sw * 0.6;
        if (u.parts.rightArm) u.parts.rightArm.rotation.x = canSee ? -0.45 : sw * 0.4;

        // Shooting (if right weapon arm wasn't blown off, or reduced accuracy if missing!)
        u.fireCd -= dt;
        if (u.fireCd <= 0 && canSee && d < 40) {
          u.fireCd = u.fireRate * (u.missing.rightArm ? 2.2 : (0.85 + Math.random()*0.35));
          const dP = Math.hypot(u.x - player.x, u.z - player.z);
          if (dP < 48) SFX.playWeapon(u.isRobot ? 'robot_laser' : 'rifle', Math.max(0.08, (1 - dP/48) * 0.48));

          const shotDir = tgtPos.clone().sub(eyePos).normalize();
          const acc = u.missing.rightArm ? 0.24 : 0.085;
          shotDir.x += (Math.random() - 0.5) * acc;
          shotDir.y += (Math.random() - 0.5) * acc * 0.6;
          shotDir.z += (Math.random() - 0.5) * acc;
          shotDir.normalize();

          const endPt = eyePos.clone().addScaledVector(shotDir, Math.min(d + 2, 42));
          spawnTracer(eyePos, endPt, u.isRobot ? 0xff1e42 : (u.faction === FACTION.RAIDER ? 0xffaa33 : 0xc084fc), 0.08);

          // Hit calculation
          const accuracyRoll = u.missing.rightArm ? 0.2 : (target.isPlayer ? 0.42 : 0.62);
          if (Math.random() < accuracyRoll) {
            if (target.isPlayer) {
              damagePlayer(u.dmg, eyePos, u.name);
            } else {
              const partList = ['torso', 'torso', 'head', 'leftArm', 'rightArm'];
              const pHit = partList[Math.floor(Math.random()*partList.length)];
              damageUnit(target, u.dmg * 1.6, pHit, tgtPos, shotDir, u.faction, u.name, u.isRobot ? '레이저 처형' : '교전 사살');
            }
          }
        }
      }
    }
  }

  // =========================================================================
  // 11. MAIN FIXED-STEP & FRAME UPDATE LOOP
  // =========================================================================
  let physicsAccum = 0;
  let ecgPhase = 0;
  const ecgCtx = document.getElementById('ecg-canvas').getContext('2d');

  function updateSimulation(rawDt) {
    // Hitstop (역경직) slow-motion crunch
    if (state.hitstop > 0) {
      state.hitstop -= rawDt;
      state.timeScale = 0.065;
    } else {
      state.timeScale += (1.0 - state.timeScale) * Math.min(1, rawDt * 18);
    }

    const dt = Math.min(rawDt, 0.05) * state.timeScale;
    state.time += dt;

    // 1. Player Movement, Jump, Recoil, ADS & Viewmodel
    if (player.alive) {
      player.ads = mouse.right && player.reloadTimer <= 0;
      const w = WEAPONS[player.wpnIdx];

      // Smooth FOV zoom on ADS
      const targetFov = player.ads ? w.adsFov : 76;
      camera.fov += (targetFov - camera.fov) * Math.min(1, rawDt * 14);
      camera.updateProjectionMatrix();

      if (player.fireCd > 0) player.fireCd -= dt;
      if (player.reloadTimer > 0) {
        player.reloadTimer -= dt;
        if (player.reloadTimer <= 0) player.ammo[player.wpnIdx] = w.mag;
      }

      // Auto-regenerate grenades slowly
      if (player.grenades < 3) {
        player.nadeRegen += dt;
        if (player.nadeRegen > 14) { player.nadeRegen = 0; player.grenades++; }
      }

      // Movement input
      let f = (keys['KeyW'] ? 1 : 0) - (keys['KeyS'] ? 1 : 0);
      let s = (keys['KeyD'] ? 1 : 0) - (keys['KeyA'] ? 1 : 0);
      const sprinting = keys['ShiftLeft'] && f > 0 && !player.ads;
      const moveSpd = player.ads ? 4.8 : (sprinting ? 11.2 : 7.8);

      const sinY = Math.sin(player.yaw), cosY = Math.cos(player.yaw);
      let mx = (-sinY * f + cosY * s);
      let mz = (-cosY * f - sinY * s);
      const ml = Math.hypot(mx, mz);
      if (ml > 0) { mx /= ml; mz /= ml; }

      player.vx += (mx * moveSpd - player.vx) * Math.min(1, dt * 13);
      player.vz += (mz * moveSpd - player.vz) * Math.min(1, dt * 13);

      // Jump & Gravity
      if (keys['Space'] && player.onGround) { player.vy = 8.4; player.onGround = false; }
      player.vy -= 23 * dt;

      player.x += player.vx * dt;
      player.y += player.vy * dt;
      player.z += player.vz * dt;
      if (player.y <= 1.7) { player.y = 1.7; player.vy = 0; player.onGround = true; }
      resolveXZColliders(player, 0.55);

      // Recoil recovery & Screen Shake
      player.recoilPitch *= Math.pow(0.002, rawDt);
      state.shake *= Math.pow(0.001, rawDt);
      if (state.shake < 0.004) state.shake = 0;

      const shkX = (Math.random() - 0.5) * state.shake * 0.25;
      const shkY = (Math.random() - 0.5) * state.shake * 0.25;
      const shkRot = (Math.random() - 0.5) * state.shake * 0.08;

      camera.position.set(player.x + shkX, player.y + shkY, player.z);
      camera.rotation.y = player.yaw;
      camera.rotation.x = Math.max(-1.42, Math.min(1.42, player.pitch + player.recoilPitch));
      camera.rotation.z = shkRot;

      // Viewmodel positioning (Hip vs ADS + Bobbing + Recoil Kick + Reload Tilt)
      if (ml > 0.1 && player.onGround) player.vmBob += dt * (sprinting ? 13 : 9);
      const bobX = Math.cos(player.vmBob) * (player.ads ? 0.003 : 0.015);
      const bobY = Math.abs(Math.sin(player.vmBob)) * (player.ads ? 0.003 : 0.016);
      player.vmKickZ *= Math.pow(0.0005, rawDt);

      const tx = player.ads ? 0.0 : 0.25;
      const ty = player.ads ? -0.155 : -0.22;
      const tz = player.ads ? -0.44 : -0.52;
      vmPivot.position.x += (tx + bobX - vmPivot.position.x) * Math.min(1, rawDt * 18);
      vmPivot.position.y += (ty - bobY - (player.reloadTimer > 0 ? 0.16 : 0) - vmPivot.position.y) * Math.min(1, rawDt * 15);
      vmPivot.position.z += (tz + player.vmKickZ - vmPivot.position.z) * Math.min(1, rawDt * 22);
      vmPivot.rotation.x = player.reloadTimer > 0 ? -0.65 : player.vmKickZ * 1.4;

      // Muzzle flash & Cyber-blade visuals
      if (player.muzzleTimer > 0) {
        player.muzzleTimer -= rawDt;
        vmMeshes.muzzle.visible = true;
        vmMeshes.muzzle.rotation.z += 1.2;
        muzzleLight.intensity = 6;
      } else {
        vmMeshes.muzzle.visible = false;
        muzzleLight.intensity = 0;
      }

      if (player.bladeTimer > 0) {
        player.bladeTimer -= rawDt;
        vmMeshes.blade.visible = true;
        const p = 1 - player.bladeTimer / 0.24;
        vmMeshes.blade.position.x = -0.55 + p * 1.2;
        vmMeshes.blade.rotation.z = -0.9 + p * 1.8;
      } else {
        vmMeshes.blade.visible = false;
      }

      if (mouse.left && (w.auto || player.fireCd <= 0)) firePlayerWeapon();

      // Low-HP Pulsing Bloody Vignette + Synthesized Heartbeat!
      const vigEl = document.getElementById('blood-vignette');
      if (player.hp < 52) {
        const severity = 1 - player.hp / 52;
        state.heartbeatCd -= rawDt;
        const beatInterval = 0.52 + (1 - severity) * 0.45;
        if (state.heartbeatCd <= 0) {
          state.heartbeatCd = beatInterval;
          SFX.playHeartbeat(0.4 + severity * 0.7);
        }
        const beatPulse = Math.max(0, Math.sin((state.heartbeatCd / beatInterval) * Math.PI));
        vigEl.style.opacity = Math.min(1, severity * 0.85 + beatPulse * 0.28).toFixed(2);
      } else {
        vigEl.style.opacity = '0';
      }

      // Glory Kill prompt check
      document.getElementById('exec-prompt').style.display = findGloryKillTarget() ? 'block' : 'none';
    }

    // 2. Director: Continuous 3-Way War Spawning + Artillery Bombardments
    state.spawnCd -= dt;
    if (state.spawnCd <= 0 && units.length < 18) {
      state.spawnCd = Math.max(2.2, 4.4 - state.wave * 0.25);
      const sp = findSpawnPoint();
      const factions = [FACTION.RAIDER, FACTION.SYNDICATE, FACTION.ROBOT];
      const f = factions[Math.floor(Math.random() * factions.length)];
      createEnemy(f, false, sp.x, sp.z);
      createEnemy(f, false, sp.x + 1.8, sp.z + 1.5);
    }

    state.artilleryCd -= dt;
    if (state.artilleryCd <= 0) {
      state.artilleryCd = Math.max(12, 20 - state.wave * 1.2);
      callArtilleryBarrage();
    }

    state.bossCd -= dt;
    if (state.bossCd <= 0 && !units.some(u => u.isBoss && u.alive)) {
      state.bossCd = 45;
      const sp = findSpawnPoint();
      createEnemy(FACTION.ROBOT, true, sp.x, sp.z);
      showCenterCallout('☠ 거대 타이탄 살육 메크 전장 진입! ☠', '#ff0033');
      SFX.playArtilleryWhistle();
    }

    // 3. Update AI Enemies
    updateEnemies(dt);

    // 4. Update Rockets
    for (let i = rockets.length - 1; i >= 0; i--) {
      const r = rockets[i];
      r.life -= dt;
      const step = r.speed * dt;
      shootRay.set(r.pos, r.dir);
      shootRay.far = step + 0.5;
      const hitW = shootRay.intersectObjects(worldHitMeshes, false);
      const hitE = shootRay.intersectObjects(enemyHitMeshes, false);
      const hit = hitW.length > 0 || hitE.length > 0;

      r.pos.addScaledVector(r.dir, step);
      r.mesh.position.copy(r.pos);
      if (Math.random() < 0.7) spawn3DParticles(r.pos, 'smoke', 1, 1.5);

      if (hit || r.life <= 0) {
        scene.remove(r.mesh);
        rockets.splice(i, 1);
        triggerExplosion(r.pos, 10.5, 195, FACTION.PLAYER, 'HYDRA 로켓', false);
      }
    }

    // 5. Update Grenades
    for (let i = grenades.length - 1; i >= 0; i--) {
      const g = grenades[i];
      g.fuse -= dt;
      g.vy -= 24 * dt;
      g.pos.x += g.vx * dt; g.pos.y += g.vy * dt; g.pos.z += g.vz * dt;
      if (g.pos.y < 0.16) { g.pos.y = 0.16; g.vy = -g.vy * 0.45; g.vx *= 0.72; g.vz *= 0.72; }
      g.mesh.position.copy(g.pos);
      if (g.fuse <= 0) {
        scene.remove(g.mesh);
        grenades.splice(i, 1);
        triggerExplosion(g.pos, 11, 180, FACTION.PLAYER, '파편 수류탄', false);
      }
    }

    // 6. Update Artillery Strikes
    for (let i = artilleryStrikes.length - 1; i >= 0; i--) {
      const a = artilleryStrikes[i];
      a.timer -= dt;
      const sc = 0.25 + (1 - Math.max(0, a.timer) / 1.7) * 0.85;
      a.ring.scale.setScalar(sc);
      if (a.timer <= 0) {
        scene.remove(a.ring);
        artilleryStrikes.splice(i, 1);
        triggerExplosion(new THREE.Vector3(a.x, 0.5, a.z), 13.5, 220, -1, '장거리 포격', true);
      }
    }

    // 7. Fixed-Step 60Hz Multi-Joint 3D Ragdoll Physics
    physicsAccum += dt;
    let steps = 0;
    while (physicsAccum >= 1/60 && steps < 3) {
      stepRagdollsFixed();
      physicsAccum -= 1/60;
      steps++;
    }

    // 8. Update Detached Spinning 3D Gibs & Shrapnel
    for (let i = gibs.length - 1; i >= 0; i--) {
      const g = gibs[i];
      g.life -= dt;
      if (g.life <= 0) { scene.remove(g.mesh); gibs.splice(i, 1); continue; }
      g.vy -= 24 * dt;
      g.mesh.position.x += g.vx * dt;
      g.mesh.position.y += g.vy * dt;
      g.mesh.position.z += g.vz * dt;
      g.mesh.rotation.x += g.rx * dt;
      g.mesh.rotation.y += g.ry * dt;
      g.mesh.rotation.z += g.rz * dt;

      if (g.isLimb && g.bounces < 2 && Math.random() < 0.35) {
        spawn3DParticles(g.mesh.position, g.isRobot ? 'spark' : 'blood', 1, 1.5);
      }
      if (g.mesh.position.y < 0.14) {
        g.mesh.position.y = 0.14;
        if (Math.abs(g.vy) > 1.5) {
          g.vy = -g.vy * 0.38;
          g.vx *= 0.65; g.vz *= 0.65;
          g.rx *= 0.6; g.ry *= 0.6; g.rz *= 0.6;
          g.bounces++;
          if (g.isLimb && g.bounces <= 2) {
            spawnDecal(new THREE.Vector3(g.mesh.position.x, 0.015, g.mesh.position.z), new THREE.Vector3(0, 1, 0), g.isRobot ? 'oil' : 'blood', 0.9);
          }
        } else {
          g.vx = g.vy = g.vz = g.rx = g.ry = g.rz = 0;
        }
      }
    }

    // 9. Update 3D Particles, Shock Spheres, Tracers, Lights & Ash
    for (let i = particles3D.length - 1; i >= 0; i--) {
      const p = particles3D[i];
      p.life -= dt;
      if (p.life <= 0) { scene.remove(p.mesh); particles3D.splice(i, 1); continue; }
      p.vy -= p.grav * dt;
      p.mesh.position.x += p.vx * dt;
      p.mesh.position.y += p.vy * dt;
      p.mesh.position.z += p.vz * dt;
      if (p.mesh.position.y < 0.05) { p.mesh.position.y = 0.05; p.vx *= 0.4; p.vy = 0; p.vz *= 0.4; }
    }

    for (let i = shockSpheres.length - 1; i >= 0; i--) {
      const s = shockSpheres[i];
      s.life -= dt;
      if (s.life <= 0) { scene.remove(s.mesh); shockSpheres.splice(i, 1); continue; }
      const pr = 1 - s.life / s.maxLife;
      s.mesh.scale.setScalar(1 + pr * s.maxR);
      s.mesh.material.opacity = (1 - pr) * 0.55;
    }

    for (let i = tracerLines.length - 1; i >= 0; i--) {
      const t = tracerLines[i];
      t.life -= rawDt;
      if (t.life <= 0) { scene.remove(t.line); t.line.geometry.dispose(); tracerLines.splice(i, 1); }
      else t.line.material.opacity = t.life / t.maxLife;
    }

    blastLight.intensity *= Math.pow(0.002, rawDt);
    for (const fl of fireLights) {
      fl.light.intensity = 1.9 + Math.sin(state.time * 14 + fl.phase) * 0.55 + Math.random() * 0.35;
    }

    // Drifting glowing ash
    const ap = ashGeo.attributes.position.array;
    for (let i = 0; i < ashCount; i++) {
      ap[i*3+1] -= dt * 1.1;
      ap[i*3]   += Math.sin(state.time + i) * dt * 0.4;
      if (ap[i*3+1] < 0) ap[i*3+1] = 22;
    }
    ashGeo.attributes.position.needsUpdate = true;

    updateHUD(rawDt);
  }

  // =========================================================================
  // 12. HUD, ECG MONITOR & CONTROLS
  // =========================================================================
  function fmtTime(s) {
    return `${String(Math.floor(s/60)).padStart(2,'0')}:${String(Math.floor(s%60)).padStart(2,'0')}`;
  }

  function updateHUD(rawDt) {
    document.getElementById('hud-wave').textContent = `SECTOR ZERO // WAVE ${String(state.wave).padStart(2,'0')}`;
    document.getElementById('hud-kills').textContent = state.kills;
    document.getElementById('hud-dismember').textContent = state.dismembers;
    document.getElementById('hud-time').textContent = fmtTime(state.time);

    document.getElementById('hp-num').textContent = Math.ceil(player.hp);
    document.getElementById('armor-num').textContent = Math.ceil(player.armor);
    document.getElementById('hp-fill').style.width = `${(player.hp/player.maxHp)*100}%`;
    document.getElementById('armor-fill').style.width = `${(player.armor/player.maxArmor)*100}%`;

    const w = WEAPONS[player.wpnIdx];
    document.getElementById('wpn-title').textContent = w.name;
    document.getElementById('ammo-big').innerHTML = player.reloadTimer > 0
      ? `<span style="color:#ff9f43; font-size:1.6rem;">RELOADING...</span>`
      : `${player.ammo[player.wpnIdx]} <span id="ammo-sub">/ ∞</span>`;
    document.getElementById('nade-count').textContent = player.grenades;

    for (let i = 0; i < 4; i++) {
      document.getElementById(`slot-${i}`).classList.toggle('active', player.wpnIdx === i);
      vmMeshes[i].visible = (player.wpnIdx === i);
    }

    // Dynamic crosshair spread
    const gap = Math.round(8 + (player.ads ? 0 : 8) + player.vmKickZ * 75);
    document.getElementById('ch-top').style.bottom = `${gap}px`;
    document.getElementById('ch-bottom').style.top = `${gap}px`;
    document.getElementById('ch-left').style.right = `${gap}px`;
    document.getElementById('ch-right').style.left = `${gap}px`;

    // Live ECG Heartbeat waveform
    ecgPhase += rawDt * (player.hp < 45 ? 3.2 : 1.5);
    ecgCtx.clearRect(0, 0, 278, 24);
    ecgCtx.strokeStyle = player.hp < 45 ? '#ff1e42' : '#22c55e';
    ecgCtx.lineWidth = 1.6;
    ecgCtx.beginPath();
    for (let x = 0; x < 278; x += 2) {
      const t = (x / 55 + ecgPhase) % 1;
      let y = 12;
      if (t > 0.42 && t < 0.48) y = 2;
      else if (t >= 0.48 && t < 0.54) y = 21;
      else if (t >= 0.54 && t < 0.6) y = 9;
      if (x === 0) ecgCtx.moveTo(x, y); else ecgCtx.lineTo(x, y);
    }
    ecgCtx.stroke();
  }

  function switchWeapon(idx) {
    if (player.wpnIdx === idx) return;
    player.wpnIdx = idx;
    player.reloadTimer = 0;
    player.vmKickZ = 0.14;
  }

  function resetGame() {
    SFX.init();
    const gfx = document.getElementById('gfx-quality').value;
    renderer.shadowMap.enabled = (gfx === 'ultra');

    // Clear dynamic entities
    for (const u of units) scene.remove(u.root);
    units.length = 0;
    for (const r of ragdolls) scene.remove(r.group);
    ragdolls.length = 0;
    for (const g of gibs) scene.remove(g.mesh);
    gibs.length = 0;
    for (const d of decals) scene.remove(d);
    decals.length = 0;
    for (const a of artilleryStrikes) scene.remove(a.ring);
    artilleryStrikes.length = 0;

    state.started = true; state.paused = false; state.dead = false;
    state.time = 0; state.wave = 1; state.kills = 0; state.dismembers = 0; state.executions = 0;
    state.shake = 0; state.hitstop = 0; state.timeScale = 1;
    state.spawnCd = 1.2; state.artilleryCd = 14; state.bossCd = 38;

    player.x = 0; player.y = 1.7; player.z = 8;
    player.vx = player.vy = player.vz = 0;
    player.yaw = 0; player.pitch = 0;
    player.hp = 100; player.armor = 100; player.alive = true;
    player.wpnIdx = 0; player.ammo = WEAPONS.map(w => w.mag);
    player.grenades = 3; player.reloadTimer = 0;

    document.getElementById('kill-feed').innerHTML = '';
    document.getElementById('start-screen').style.display = 'none';
    document.getElementById('pause-screen').style.display = 'none';
    document.getElementById('death-screen').style.display = 'none';
    document.getElementById('hud').style.display = 'block';
    document.getElementById('crosshair-wrap').style.display = 'block';

    // Immediate 3-way faction battle right in front of the player!
    createEnemy(FACTION.RAIDER, false, -8, -12);
    createEnemy(FACTION.RAIDER, false, -11, -15);
    createEnemy(FACTION.SYNDICATE, false, 8, -12);
    createEnemy(FACTION.SYNDICATE, false, 11, -15);
    createEnemy(FACTION.ROBOT, false, 0, -24);
    createEnemy(FACTION.ROBOT, false, 4, -26);

    document.body.requestPointerLock();
  }

  // Input Listeners
  document.getElementById('sens-slider').addEventListener('input', e => {
    const v = parseFloat(e.target.value);
    document.getElementById('sens-val').textContent = v.toFixed(1);
    state.sens = 0.0022 * v;
  });

  document.getElementById('deploy-btn').onclick = resetGame;
  document.getElementById('redeploy-btn').onclick = resetGame;
  document.getElementById('restart-pause-btn').onclick = resetGame;
  document.getElementById('resume-btn').onclick = () => {
    document.getElementById('pause-screen').style.display = 'none';
    document.body.requestPointerLock();
  };

  document.addEventListener('pointerlockchange', () => {
    const locked = document.pointerLockElement === document.body;
    if (state.started && !state.dead) {
      state.paused = !locked;
      document.getElementById('pause-screen').style.display = locked ? 'none' : 'flex';
      if (!locked) { mouse.left = false; mouse.right = false; for (const k in keys) keys[k] = false; }
    }
  });

  window.addEventListener('mousemove', e => {
    if (!state.started || state.paused || state.dead) return;
    if (document.pointerLockElement === document.body) {
      player.yaw -= e.movementX * state.sens * (player.ads ? 0.6 : 1.0);
      player.pitch -= e.movementY * state.sens * (player.ads ? 0.6 : 1.0);
      player.pitch = Math.max(-1.42, Math.min(1.42, player.pitch));
    }
  });

  window.addEventListener('mousedown', e => {
    if (!state.started || state.paused || state.dead) return;
    if (document.pointerLockElement !== document.body) { document.body.requestPointerLock(); return; }
    if (e.button === 0) { mouse.left = true; firePlayerWeapon(); }
    if (e.button === 2) mouse.right = true;
  });
  window.addEventListener('mouseup', e => {
    if (e.button === 0) mouse.left = false;
    if (e.button === 2) mouse.right = false;
  });
  window.addEventListener('contextmenu', e => e.preventDefault());

  window.addEventListener('keydown', e => {
    keys[e.code] = true;
    if (!state.started || state.paused || state.dead) return;
    if (e.code === 'Digit1') switchWeapon(0);
    if (e.code === 'Digit2') switchWeapon(1);
    if (e.code === 'Digit3') switchWeapon(2);
    if (e.code === 'Digit4') switchWeapon(3);
    if (e.code === 'KeyR') startReload();
    if (e.code === 'KeyG') throwGrenade();
    if (e.code === 'KeyE') performGloryKill();
  });
  window.addEventListener('keyup', e => { keys[e.code] = false; });
  window.addEventListener('wheel', e => {
    if (!state.started || state.paused || state.dead) return;
    switchWeapon((player.wpnIdx + (e.deltaY > 0 ? 1 : -1) + 4) % 4);
  }, { passive: true });

  // =========================================================================
  // 13. RENDER LOOP (Live Cinematic Orbit Camera on Title Screen)
  // =========================================================================
  let lastT = performance.now();
  function animate(now) {
    requestAnimationFrame(animate);
    const rawDt = Math.min((now - lastT) / 1000, 0.08);
    lastT = now;

    if (state.started && !state.paused && !state.dead) {
      updateSimulation(rawDt);
    } else if (!state.started) {
      // Apocalyptic burning city flyover camera on start menu
      const t = now * 0.00022;
      camera.position.set(Math.cos(t) * 28, 9.5 + Math.sin(t * 2) * 1.5, Math.sin(t) * 28);
      camera.lookAt(0, 2.5, 0);
      vmPivot.visible = false;
    }
    if (state.started) vmPivot.visible = true;

    renderer.render(scene, camera);
  }
  requestAnimationFrame(animate);
})();
</script>
