</div>

<!-- Pause Screen -->
<div id="pause-screen" class="overlay-screen">
  <div class="panel" style="max-width:480px; text-align:center;">
    <div class="title-main" style="font-size:2.4rem;">PAUSED</div>
    <p style="color:#94a3b8; margin:12px 0 22px; font-size:0.9rem;">화면을 클릭하면 다시 1인칭 시점으로 복귀합니다.</p>
    <button id="resume-btn" class="btn-deploy" style="margin-bottom:10px;">전투 복귀 [RESUME]</button>
    <button id="restart-pause-btn" class="btn-deploy" style="background:#1e293b; font-size:0.95rem; padding:12px;">처음부터 재시작</button>
  </div>
</div>

<!-- Death Screen -->
<div id="death-screen" class="overlay-screen">
  <div class="panel" style="max-width:620px; text-align:center;">
    <div style="font-family:'Share Tech Mono',monospace; color:#ff2a4b; letter-spacing:4px;">KIA // CRITICAL TRAUMA DETECTED</div>
    <div class="title-main" style="font-size:3rem; margin-top:4px;">YOU ARE DEAD</div>
    <p id="death-msg" style="color:#cbd5e1; margin-top:8px; font-size:0.95rem;"></p>

    <div class="stat-grid">
      <div class="stat-card"><div class="stat-v" id="st-time">00:00</div><div class="stat-l">생존 시간</div></div>
      <div class="stat-card"><div class="stat-v" id="st-kills">0</div><div class="stat-l">총 처치</div></div>
      <div class="stat-card"><div class="stat-v" id="st-dism">0</div><div class="stat-l">부위 파괴</div></div>
      <div class="stat-card"><div class="stat-v" id="st-exec">0</div><div class="stat-l">글로리 킬</div></div>
    </div>

    <button id="redeploy-btn" class="btn-deploy">전장 재투입 [REDEPLOY]</button>
  </div>
</div>

<script>
(() => {
  'use strict';

  if (typeof THREE === 'undefined') {
    document.getElementById('offline-warn').style.display = 'block';
    document.getElementById('deploy-btn').disabled = true;
    return;
  }

  // =========================================================================
  // 1. PRO-GRADE WEB AUDIO ENGINE (City Convolution Reverb + Layered SFX)
  // =========================================================================
  class WarAudio {
    constructor() {
      this.ctx = null;
      this.master = null;
      this.reverb = null;
      this.reverbSend = null;
      this.noiseBuf = null;
      this.started = false;
    }

    init() {
      if (this.ctx) {
        if (this.ctx.state === 'suspended') this.ctx.resume();
        return;
      }
      const AC = window.AudioContext || window.webkitAudioContext;
      this.ctx = new AC();

      const comp = this.ctx.createDynamicsCompressor();
      comp.threshold.value = -12;
      comp.knee.value = 16;
      comp.ratio.value = 9;
      comp.attack.value = 0.002;
      comp.release.value = 0.14;

      this.master = this.ctx.createGain();
      this.master.gain.value = 0.52;
      this.master.connect(comp);
      comp.connect(this.ctx.destination);

      // White noise buffer
      const sr = this.ctx.sampleRate;
      this.noiseBuf = this.ctx.createBuffer(1, sr * 2.5, sr);
      const d = this.noiseBuf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;

      // Synthesized Urban Canyon Impulse Response for genuine battlefield echo!
      const irLen = Math.floor(sr * 1.45);
      const irBuf = this.ctx.createBuffer(2, irLen, sr);
      for (let ch = 0; ch < 2; ch++) {
        const ir = irBuf.getChannelData(ch);
        for (let i = 0; i < irLen; i++) {
          const decay = Math.pow(1 - i / irLen, 2.8);
          ir[i] = (Math.random() * 2 - 1) * decay;
        }
      }
      this.reverb = this.ctx.createConvolver();
      this.reverb.buffer = irBuf;
      this.reverbSend = this.ctx.createGain();
      this.reverbSend.gain.value = 0.34;
      this.reverbSend.connect(this.reverb);
      this.reverb.connect(this.master);

      this.startWarAmbience();
    }

    startWarAmbience() {
      if (this.started || !this.ctx) return;
      this.started = true;
      // Distant burning wind & rumble
      const wind = this.ctx.createBufferSource();
      wind.buffer = this.noiseBuf; wind.loop = true;
      const filt = this.ctx.createBiquadFilter();
      filt.type = 'lowpass'; filt.frequency.value = 210;
      const g = this.ctx.createGain(); g.gain.value = 0.09;
      wind.connect(filt); filt.connect(g); g.connect(this.master);
      wind.start();
    }

    playWeapon(type, vol = 1.0) {
      if (!this.ctx || vol < 0.03) return;
      const t = this.ctx.currentTime;
      const v = Math.min(1, vol);

      if (type === 'rifle') {
        this._noise(t, 0.11, 1650, 'bandpass', 0.72 * v, true);
        this._noise(t, 0.06, 4200, 'highpass', 0.35 * v, false); // supersonic crack
        this._osc(t, 'triangle', 180, 42, 0.11, 0.65 * v, true);
        this._osc(t + 0.03, 'square', 920, 480, 0.03, 0.16 * v, false); // bolt clack
      } else if (type === 'shotgun') {
        this._noise(t, 0.32, 850, 'lowpass', 1.15 * v, true);
        this._noise(t, 0.14, 2400, 'bandpass', 0.65 * v, true);
        this._osc(t, 'sine', 145, 24, 0.3, 1.05 * v, true);
        this._osc(t + 0.22, 'sawtooth', 320, 190, 0.08, 0.18 * v, false); // heavy pump
      } else if (type === 'railgun') {
        this._noise(t, 0.42, 2600, 'highpass', 0.9 * v, true);
        this._osc(t, 'sawtooth', 1400, 55, 0.45, 0.85 * v, true);
        this._osc(t, 'sine', 210, 26, 0.4, 0.95 * v, true);
      } else if (type === 'rocket') {
        this._noise(t, 0.48, 720, 'bandpass', 0.85 * v, true);
        this._osc(t, 'sawtooth', 160, 55, 0.35, 0.75 * v, false);
      } else if (type === 'robot_laser') {
        this._osc(t, 'sawtooth', 860, 160, 0.14, 0.38 * v, true);
        this._noise(t, 0.08, 2200, 'bandpass', 0.28 * v, false);
      }
    }

    playExplosion(vol = 1.0, nearPlayer = false) {
      if (!this.ctx || vol < 0.03) return;
      const t = this.ctx.currentTime;
      const v = Math.min(1.2, vol);
      // Massive layered shockwave boom
      this._noise(t, 0.85, 420, 'lowpass', 1.25 * v, true);
      this._noise(t + 0.04, 0.55, 1100, 'bandpass', 0.7 * v, true);
      this._osc(t, 'sine', 110, 16, 0.75, 1.25 * v, true);

      // Concussive ear ringing (tinnitus) if very close!
      if (nearPlayer) {
        const osc = this.ctx.createOscillator();
        osc.type = 'sine'; osc.frequency.value = 3950;
        const g = this.ctx.createGain();
        g.gain.setValueAtTime(0.08, t);
        g.gain.exponentialRampToValueAtTime(0.0005, t + 1.8);
        osc.connect(g); g.connect(this.master);
        osc.start(t); osc.stop(t + 1.85);
      }
    }

    playArtilleryWhistle() {
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      this._osc(t, 'sine', 1150, 260, 1.65, 0.18, true);
      this._noise(t, 1.6, 1400, 'bandpass', 0.08, true);
    }

    playHitMarker(crit = false, dismember = false) {
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      // Crisp CoD-style tick
      this._osc(t, 'triangle', crit ? 2200 : 1550, 750, 0.045, crit ? 0.45 : 0.28, false);
      if (crit || dismember) {
        // Visceral bone/armor crunch!
        this._noise(t, 0.12, 1300, 'bandpass', 0.65, false);
        this._osc(t, 'sawtooth', 420, 95, 0.11, 0.45, false);
      }
    }

    playGloryKill() {
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      this._noise(t, 0.25, 2200, 'bandpass', 0.95, true);
      this._osc(t, 'sawtooth', 540, 60, 0.28, 0.8, true);
      this._osc(t, 'sine', 140, 24, 0.35, 1.0, true);
    }

    playHeartbeat(intensity = 0.6) {
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      this._osc(t, 'sine', 72, 34, 0.14, 0.55 * intensity, false);
      this._osc(t + 0.18, 'sine', 64, 30, 0.16, 0.42 * intensity, false);
    }

    playShellClink() {
      if (!this.ctx) return;
      const t = this.ctx.currentTime + 0.22;
      this._osc(t, 'sine', 3800 + Math.random()*700, 3200, 0.04, 0.06, false);
    }

    playReload() {
      if (!this.ctx) return;
      const t = this.ctx.currentTime;
      this._osc(t, 'square', 320, 180, 0.06, 0.18, false);
      this._osc(t + 0.45, 'square', 580, 740, 0.06, 0.22, false);
    }

    _noise(t, dur, freq, type, gain, sendRev) {
      const src = this.ctx.createBufferSource();
      src.buffer = this.noiseBuf;
      const f = this.ctx.createBiquadFilter();
      f.type = type; f.frequency.setValueAtTime(freq, t);
      const g = this.ctx.createGain();
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      src.connect(f); f.connect(g);
      g.connect(this.master);
      if (sendRev) g.connect(this.reverbSend);
      src.start(t, Math.random() * 1.1, dur + 0.03);
    }

    _osc(t, type, f1, f2, dur, gain, sendRev) {
      const o = this.ctx.createOscillator();
      o.type = type;
      o.frequency.setValueAtTime(f1, t);
      o.frequency.exponentialRampToValueAtTime(Math.max(14, f2), t + dur);
      const g = this.ctx.createGain();
      g.gain.setValueAtTime(gain, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g);
      g.connect(this.master);
      if (sendRev) g.connect(this.reverbSend);
      o.start(t); o.stop(t + dur + 0.03);
    }
  }

  const SFX = new WarAudio();

  // =========================================================================
  // 2. PROCEDURAL HIGH-RES TEXTURES (Concrete, Asphalt, Blood Decals, Blood Vignette)
  // =========================================================================
  function makeCanvasTex(size, drawFn, repeat = 1) {
    const c = document.createElement('canvas');
    c.width = c.height = size;
    drawFn(c.getContext('2d'), size);
    const tex = new THREE.CanvasTexture(c);
    if (repeat > 1) {
      tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(repeat, repeat);
    }
    return tex;
  }

  const TEX = {
    asphalt: makeCanvasTex(512, (ctx, s) => {
      ctx.fillStyle = '#1b1d22'; ctx.fillRect(0, 0, s, s);
      for (let i = 0; i < 6000; i++) {
        ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.04)' : 'rgba(0,0,0,0.22)';
        ctx.fillRect(Math.random()*s, Math.random()*s, 2+Math.random()*3, 2+Math.random()*3);
      }
      // Road cracks & ash streaks
      ctx.strokeStyle = 'rgba(0,0,0,0.65)'; ctx.lineWidth = 2;
      for (let i = 0; i < 16; i++) {
        let x = Math.random()*s, y = Math.random()*s;
        ctx.beginPath(); ctx.moveTo(x, y);
        for (let k = 0; k < 6; k++) { x += (Math.random()-0.5)*70; y += (Math.random()-0.5)*70; ctx.lineTo(x, y); }
        ctx.stroke();
      }
    }, 18),

    concrete: makeCanvasTex(512, (ctx, s) => {
      ctx.fillStyle = '#393d45'; ctx.fillRect(0, 0, s, s);
      // Brutalist panel seams
      ctx.strokeStyle = 'rgba(0,0,0,0.42)'; ctx.lineWidth = 4;
      for (let y = 0; y < s; y += 128) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(s, y); ctx.stroke(); }
      for (let x = 0; x < s; x += 128) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, s); ctx.stroke(); }
      // Grime, soot & wear
      for (let i = 0; i < 5500; i++) {
        ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.045)' : 'rgba(10,12,15,0.22)';
        ctx.fillRect(Math.random()*s, Math.random()*s, 3+Math.random()*5, 3+Math.random()*5);
      }
      // Dark water/ash drips from top
      for (let i = 0; i < 32; i++) {
        const x = Math.random()*s, h = 40 + Math.random()*200;
        const g = ctx.createLinearGradient(x, 0, x, h);
        g.addColorStop(0, 'rgba(0,0,0,0.42)'); g.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = g; ctx.fillRect(x, 0, 4+Math.random()*12, h);
      }
    }, 2),

    crate: makeCanvasTex(256, (ctx, s) => {
      ctx.fillStyle = '#473c2e'; ctx.fillRect(0, 0, s, s);
      ctx.strokeStyle = '#1f1912'; ctx.lineWidth = 14; ctx.strokeRect(7, 7, s-14, s-14);
      ctx.beginPath(); ctx.moveTo(0, 0); ctx.lineTo(s, s); ctx.moveTo(s, 0); ctx.lineTo(0, s); ctx.stroke();
      ctx.fillStyle = '#d97706'; ctx.font = 'bold 28px monospace'; ctx.textAlign = 'center';
      ctx.fillText('AMMO', s/2, s/2 + 10);
    }, 1),

    barrel: makeCanvasTex(256, (ctx, s) => {
      ctx.fillStyle = '#991b1b'; ctx.fillRect(0, 0, s, s);
      ctx.fillStyle = '#18181b'; ctx.fillRect(0, 96, s, 64);
      ctx.fillStyle = '#facc15'; ctx.font = '900 32px monospace'; ctx.textAlign = 'center';
      ctx.fillText('EXPLOSIVE', s/2, 138);
      for (let i = 0; i < 600; i++) {
        ctx.fillStyle = 'rgba(0,0,0,0.25)'; ctx.fillRect(Math.random()*s, Math.random()*s, 4, 4);
      }
    }, 1),

    bloodDecals: [0, 1, 2].map(() => makeCanvasTex(256, (ctx, s) => {
      const cx = s/2, cy = s/2;
      // Rich organic splatter blobs + streaks
      for (let i = 0; i < 28; i++) {
        const ang = Math.random() * Math.PI * 2;
        const dist = Math.pow(Math.random(), 1.6) * (s * 0.42);
        const rx = cx + Math.cos(ang) * dist;
        const ry = cy + Math.sin(ang) * dist;
        const rad = (i < 5 ? 26 : 5) + Math.random() * (i < 5 ? 24 : 18);
        ctx.fillStyle = Math.random() > 0.35 ? 'rgba(135, 6, 14, 0.92)' : 'rgba(68, 2, 8, 0.95)';
        ctx.beginPath();
        ctx.ellipse(rx, ry, rad * (1 + Math.random()*0.6), rad * 0.8, ang, 0, Math.PI*2);
        ctx.fill();
      }
      // Directional spray droplets
      for (let i = 0; i < 42; i++) {
        const ang = Math.random() * Math.PI * 2;
        const dist = 25 + Math.random() * (s * 0.45);
        ctx.fillStyle = 'rgba(155, 10, 18, 0.85)';
        ctx.beginPath();
        ctx.ellipse(cx + Math.cos(ang)*dist, cy + Math.sin(ang)*dist, 2+Math.random()*5, 1.5+Math.random()*2.5, ang, 0, Math.PI*2);
        ctx.fill();
      }
    })),

    oilDecal: makeCanvasTex(256, (ctx, s) => {
      const cx = s/2, cy = s/2;
      for (let i = 0; i < 24; i++) {
        const ang = Math.random() * Math.PI * 2;
        const dist = Math.pow(Math.random(), 1.5) * (s * 0.4);
        const rad = 10 + Math.random() * 28;
        ctx.fillStyle = Math.random() > 0.25 ? 'rgba(8, 10, 14, 0.94)' : 'rgba(20, 28, 38, 0.85)';
        ctx.beginPath(); ctx.arc(cx + Math.cos(ang)*dist, cy + Math.sin(ang)*dist, rad, 0, Math.PI*2); ctx.fill();
      }
    }),

    scorchDecal: makeCanvasTex(256, (ctx, s) => {
      const g = ctx.createRadialGradient(s/2, s/2, 8, s/2, s/2, s*0.48);
      g.addColorStop(0, 'rgba(5, 4, 4, 0.98)');
      g.addColorStop(0.5, 'rgba(22, 16, 12, 0.78)');
      g.addColorStop(0.8, 'rgba(30, 20, 14, 0.25)');
      g.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, s, s);
    }),

    bulletHole: makeCanvasTex(128, (ctx, s) => {
      const cx = s/2, cy = s/2;
      const g = ctx.createRadialGradient(cx, cy, 4, cx, cy, 38);
      g.addColorStop(0, 'rgba(5,5,5,1)'); g.addColorStop(0.35, 'rgba(45,45,45,0.85)'); g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, 40, 0, Math.PI*2); ctx.fill();
      ctx.strokeStyle = 'rgba(15,15,15,0.9)'; ctx.lineWidth = 2;
      for (let i = 0; i < 7; i++) {
        const a = (i/7)*Math.PI*2 + Math.random()*0.4;
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx+Math.cos(a)*46, cy+Math.sin(a)*46); ctx.stroke();
      }
    })
  };

  // Generate dramatic organic blood-vein Low-HP vignette canvas
  function renderBloodVignetteOverlay() {
    const c = document.getElementById('blood-vignette');
    c.width = window.innerWidth; c.height = window.innerHeight;
    const ctx = c.getContext('2d');
    const w = c.width, h = c.height;
    const g = ctx.createRadialGradient(w/2, h/2, Math.min(w, h)*0.24, w/2, h/2, Math.max(w, h)*0.7);
    g.addColorStop(0, 'rgba(120,0,10,0)');
    g.addColorStop(0.58, 'rgba(140,4,16,0.32)');
    g.addColorStop(0.85, 'rgba(160,6,18,0.82)');
    g.addColorStop(1, 'rgba(90,0,8,0.98)');
    ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);

    // Organic crimson splatters & arterial veins along viewport edges
    for (let i = 0; i < 85; i++) {
      const edge = Math.floor(Math.random() * 4);
      let x, y;
      if (edge === 0) { x = Math.random()*w; y = Math.random()*h*0.18; }
      else if (edge === 1) { x = Math.random()*w; y = h - Math.random()*h*0.18; }
      else if (edge === 2) { x = Math.random()*w*0.16; y = Math.random()*h; }
      else { x = w - Math.random()*w*0.16; y = Math.random()*h; }
      ctx.fillStyle = `rgba(${130 + Math.random()*55}, 4, 14, ${0.35 + Math.random()*0.45})`;
      ctx.beginPath();
      ctx.ellipse(x, y, 8 + Math.random()*28, 5 + Math.random()*20, Math.random()*Math.PI, 0, Math.PI*2);
      ctx.fill();
    }
  }
  renderBloodVignetteOverlay();

  // =========================================================================
  // 3. THREE.JS SCENE, LIGHTING, CINEMATIC SKY & WARZONE MAP
  // =========================================================================
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x160a0c);
  scene.fog = new THREE.FogExp2(0x1a0c0e, 0.0155);

  const camera = new THREE.PerspectiveCamera(76, window.innerWidth / window.innerHeight, 0.08, 220);
  camera.rotation.order = 'YXZ';
  scene.add(camera);

  const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.8));
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.18;
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  document.getElementById('webgl-container').appendChild(renderer.domElement);

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderBloodVignetteOverlay();
  });

  // Dramatic apocalyptic lighting
  const hemiLight = new THREE.HemisphereLight(0xff7755, 0x161b26, 0.65);
  scene.add(hemiLight);

  const sunLight = new THREE.DirectionalLight(0xff9b6a, 1.35);
  sunLight.position.set(42, 62, 30);
  sunLight.castShadow = true;
  sunLight.shadow.mapSize.set(1024, 1024);
  sunLight.shadow.camera.near = 10;
