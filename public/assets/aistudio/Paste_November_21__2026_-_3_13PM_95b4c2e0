  function spawnDecal(point, normal, type, size = 1.4) {
    let tex;
    if (type === 'blood') tex = TEX.bloodDecals[Math.floor(Math.random() * TEX.bloodDecals.length)];
    else if (type === 'oil') tex = TEX.oilDecal;
    else if (type === 'scorch') tex = TEX.scorchDecal;
    else tex = TEX.bulletHole;

    const mat = new THREE.MeshBasicMaterial({
      map: tex, transparent: true, depthWrite: false,
      polygonOffset: true, polygonOffsetFactor: -2,
      opacity: type === 'bullet' ? 0.85 : 0.94
    });

    const mesh = new THREE.Mesh(decalPlaneGeo, mat);
    mesh.scale.set(size, size, 1);
    mesh.position.copy(point).addScaledVector(normal, 0.025 + Math.random() * 0.02);
    mesh.lookAt(mesh.position.clone().add(normal));
    mesh.rotateZ(Math.random() * Math.PI * 2);
    scene.add(mesh);

    decals.push(mesh);
    if (decals.length > MAX_DECALS) {
      const old = decals.shift();
      scene.remove(old);
      old.material.dispose();
    }
  }

  // Cast a blood/oil splatter ray from hit position onto nearby walls or floor!
  const splatterRay = new THREE.Raycaster();
  function projectSplatterDecal(origin, dir, isRobot, size = 1.65) {
    // 1. Project along bullet/impact direction to paint walls behind the victim!
    splatterRay.set(origin, dir.clone().normalize());
    splatterRay.far = 7.5;
    const hits = splatterRay.intersectObjects(worldHitMeshes, false);
    if (hits.length > 0 && hits[0].face) {
      const h = hits[0];
      const worldNorm = h.face.normal.clone().transformDirection(h.object.matrixWorld).normalize();
      spawnDecal(h.point, worldNorm, isRobot ? 'oil' : 'blood', size * (0.85 + Math.random()*0.45));
    }
    // 2. Also splatter onto the ground beneath the victim
    spawnDecal(
      new THREE.Vector3(origin.x + (Math.random()-0.5)*1.2, 0.01, origin.z + (Math.random()-0.5)*1.2),
      new THREE.Vector3(0, 1, 0),
      isRobot ? 'oil' : 'blood',
      size * (0.75 + Math.random()*0.5)
    );
  }

