  function rebuildHitMeshCache() {
    enemyHitMeshes = [];
    for (let i = 0; i < units.length; i++) {
      const u = units[i];
      if (!u.alive) continue;
      for (const k in u.parts) {
        if (u.parts[k] && u.parts[k].visible) enemyHitMeshes.push(u.parts[k]);
      }
    }
  }

  function createEnemy(faction, isBoss, x, z) {
    const s = isBoss ? 1.55 : 1.0;
    const isRobot = faction === FACTION.ROBOT;
    const root = new THREE.Group();
    root.position.set(x, 0, z);

    const bodyColor = isBoss ? 0x1e293b : FACTION_INFO[faction].color;
    const armorMat = new THREE.MeshStandardMaterial({ color: bodyColor, roughness: isRobot ? 0.35 : 0.78, metalness: isRobot ? 0.85 : 0.25 });
    const limbMat  = new THREE.MeshStandardMaterial({ color: isRobot ? 0x1e242e : 0x26282e, roughness: 0.65, metalness: isRobot ? 0.8 : 0.15 });
    const headMat  = new THREE.MeshStandardMaterial({ color: isRobot ? 0x2c3442 : (faction === FACTION.RAIDER ? 0x7c4a32 : 0x1e1b4b), roughness: 0.6, metalness: isRobot ? 0.85 : 0.2 });
    const visorColor = isRobot ? 0xff002b : (faction === FACTION.RAIDER ? 0xffaa00 : 0xc084fc);
    const visorMat = new THREE.MeshBasicMaterial({ color: visorColor });

    const unit = {
      id: Math.random(),
      faction, isRobot, isBoss,
      name: isBoss ? '타이탄 살육 메크' : (isRobot ? '에이펙스 킬러봇' : (faction === FACTION.RAIDER ? '약탈자' : '신디케이트 특공대')),
      scale: s,
      root,
      x, y: 0, z, vx: 0, vz: 0,
      r: 0.58 * s,
      yaw: Math.random() * Math.PI * 2,
      hp: (isBoss ? 520 : (isRobot ? 115 : 85)) * (1 + (state.wave - 1) * 0.12),
      maxHp: 1,
      speed: isBoss ? 3.2 : (isRobot ? 4.8 : (faction === FACTION.RAIDER ? 6.1 : 5.2)),
      fireRate: isBoss ? 0.24 : (isRobot ? 0.72 : (faction === FACTION.RAIDER ? 0.95 : 0.52)),
      fireCd: Math.random() * 0.8,
      dmg: isBoss ? 14 : (isRobot ? 12 : 9),
      parts: {},
      missing: { head: false, leftArm: false, rightArm: false, leftLeg: false, rightLeg: false },
      staggerTimer: 0,
      walkPhase: Math.random() * 10,
      strafeDir: Math.random() > 0.5 ? 1 : -1,
      strafeCd: 1.5,
      hitFlash: 0,
      mats: [armorMat, limbMat, headMat],
      alive: true
    };
    unit.maxHp = unit.hp;

    function makePart(partName, geo, mat, px, py, pz, parent) {
      const m = new THREE.Mesh(geo, mat);
      m.position.set(px, py, pz);
      m.castShadow = true; m.receiveShadow = true;
      m.userData = { unit, part: partName };
      parent.add(m);
      unit.parts[partName] = m;
      return m;
    }

    // Articulated skeletal hierarchy
    const torso = makePart('torso', new THREE.BoxGeometry(0.62*s, 0.74*s, 0.36*s), armorMat, 0, 1.15*s, 0, root);

    // Head + Glowing Optics/Visor
    const head = makePart('head', new THREE.BoxGeometry(0.36*s, 0.38*s, 0.36*s), headMat, 0, 0.58*s, 0, torso);
    const visor = new THREE.Mesh(new THREE.BoxGeometry(0.28*s, 0.1*s, 0.06*s), visorMat);
    visor.position.set(0, 0.03*s, 0.17*s);
    visor.userData = { unit, part: 'head' };
    head.add(visor);

    // Arms (Right arm carries weapon)
    makePart('leftArm', new THREE.BoxGeometry(0.21*s, 0.68*s, 0.21*s), limbMat, -0.45*s, 0.02*s, 0.08*s, torso);
    const rArm = makePart('rightArm', new THREE.BoxGeometry(0.21*s, 0.68*s, 0.21*s), limbMat, 0.45*s, 0.02*s, 0.15*s, torso);
    const gun = new THREE.Mesh(new THREE.BoxGeometry(0.11*s, 0.13*s, 0.65*s), MAT.darkIron);
    gun.position.set(0, -0.14*s, 0.36*s);
    gun.userData = { unit, part: 'rightArm' };
    rArm.add(gun);

    // Legs
    makePart('leftLeg',  new THREE.BoxGeometry(0.24*s, 0.76*s, 0.24*s), limbMat, -0.18*s, 0.4*s, 0, root);
    makePart('rightLeg', new THREE.BoxGeometry(0.24*s, 0.76*s, 0.24*s), limbMat,  0.18*s, 0.4*s, 0, root);

    scene.add(root);
    units.push(unit);
    rebuildHitMeshCache();
    return unit;
  }

  // Spawn spinning detached 3D body part / debris chunk (Gib)
  function spawnDetachedGib(pos, vel, sizeVec, mat, isRobot, isLimb = true) {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(sizeVec.x, sizeVec.y, sizeVec.z), mat.clone());
    mesh.position.copy(pos);
    mesh.castShadow = true;
    scene.add(mesh);

    gibs.push({
      mesh,
      vx: vel.x, vy: vel.y, vz: vel.z,
      rx: (Math.random() - 0.5) * 18,
      ry: (Math.random() - 0.5) * 18,
      rz: (Math.random() - 0.5) * 18,
      isRobot, isLimb,
      life: 9.0,
      bounces: 0
    });
    if (gibs.length > 48) {
      const old = gibs.shift();
      scene.remove(old.mesh);
      old.mesh.geometry.dispose();
    }
  }

  // Dismember a specific body part from a live enemy!
  function dismemberPart(unit, partName, hitDir, power = 1.0) {
    if (!unit.parts[partName] || unit.missing[partName] || partName === 'torso') return false;
    const mesh = unit.parts[partName];
    const worldPos = new THREE.Vector3();
    mesh.getWorldPosition(worldPos);

    unit.missing[partName] = true;
    mesh.visible = false;
    rebuildHitMeshCache();

    // Add dripping stump!
    const stump = new THREE.Mesh(
      new THREE.BoxGeometry(0.16*unit.scale, 0.14*unit.scale, 0.16*unit.scale),
      unit.isRobot ? MAT.sparkMat : MAT.bloodMat
    );
    stump.position.copy(mesh.position);
    if (mesh.parent) mesh.parent.add(stump);

    // Launch the detached 3D mesh spinning violently into the air!
    const geoP = mesh.geometry.parameters;
    const launchVel = new THREE.Vector3(
      hitDir.x * (6 + power * 6) + (Math.random() - 0.5) * 5,
      4.5 + Math.random() * 5.5,
      hitDir.z * (6 + power * 6) + (Math.random() - 0.5) * 5
    );
    spawnDetachedGib(worldPos, launchVel, new THREE.Vector3(geoP.width, geoP.height, geoP.depth), mesh.material, unit.isRobot, true);

    // Massive visceral arterial spray / spark burst + wall decal!
    spawn3DParticles(worldPos, unit.isRobot ? 'spark' : 'blood', 26, 7.5);
    projectSplatterDecal(worldPos, hitDir, unit.isRobot, 2.0);

    state.dismembers++;
    unit.staggerTimer = 2.6; // Stagger makes enemy vulnerable to DOOM Glory Kill!
    return true;
  }

  // =========================================================================
  // TRUE MULTI-JOINT 3D VERLET RAGDOLL SYSTEM (7 Nodes, 6 Stick Constraints!)
  // =========================================================================
  function spawnRagdoll(unit, impulseVec) {
    const s = unit.scale;
    const base = new THREE.Vector3(unit.x, 0, unit.z);
    const cos = Math.cos(unit.yaw), sin = Math.sin(unit.yaw);
    const toW = (lx, ly, lz) => new THREE.Vector3(
      base.x + lx * cos + lz * sin,
      ly * s,
      base.z - lx * sin + lz * cos
    );

    const makeNode = (pos, impScale = 1.0) => {
      const iv = impulseVec.clone().multiplyScalar(impScale);
      iv.x += (Math.random() - 0.5) * 2.8;
      iv.y += 1.2 + Math.random() * 2.4;
      iv.z += (Math.random() - 0.5) * 2.8;
      return {
        x: pos.x, y: Math.max(0.18, pos.y), z: pos.z,
        ox: pos.x - iv.x * (1/60),
        oy: Math.max(0.18, pos.y) - iv.y * (1/60),
        oz: pos.z - iv.z * (1/60),
        r: 0.2 * s
      };
    };

    const nodes = {
      pelvis: makeNode(toW(0, 0.85, 0), 1.0),
      chest:  makeNode(toW(0, 1.48, 0), 1.25),
      head:   makeNode(toW(0, 1.88, 0), 1.35),
      lHand:  makeNode(toW(-0.55, 1.05, 0.15), 1.1),
      rHand:  makeNode(toW( 0.55, 1.05, 0.15), 1.1),
      lFoot:  makeNode(toW(-0.22, 0.18, 0), 0.7),
      rFoot:  makeNode(toW( 0.22, 0.18, 0), 0.7)
    };

    // Distance constraints connecting the skeleton
    const links = [
      ['pelvis', 'chest',  0.65 * s],
      ['chest',  'head',   0.42 * s],
      ['chest',  'lHand',  0.68 * s],
      ['chest',  'rHand',  0.68 * s],
      ['pelvis', 'lFoot',  0.76 * s],
      ['pelvis', 'rFoot',  0.76 * s],
      // Cross braces to keep ragdoll realistic without collapsing flat
      ['pelvis', 'head',   1.02 * s],
      ['lFoot',  'rFoot',  0.42 * s]
    ];

    const group = new THREE.Group();
    scene.add(group);
    const bodyMat = unit.mats[0].clone();
    const limbMat = unit.mats[1].clone();
    const headMat = unit.mats[2].clone();

    // Z-aligned limb boxes so mesh.lookAt(nodeB) aligns seamlessly!
    const visuals = [];
    const addBoneMesh = (a, b, w, h, len, mat, skip = false) => {
      if (skip) return;
      const m = new THREE.Mesh(new THREE.BoxGeometry(w*s, h*s, len*s), mat);
      m.castShadow = true; m.receiveShadow = true;
      group.add(m);
      visuals.push({ a, b, mesh: m });
    };

    addBoneMesh('pelvis', 'chest',  0.58, 0.34, 0.70, bodyMat, false);
    addBoneMesh('chest',  'head',   0.34, 0.34, 0.36, headMat, unit.missing.head);
    addBoneMesh('chest',  'lHand',  0.19, 0.19, 0.66, limbMat, unit.missing.leftArm);
    addBoneMesh('chest',  'rHand',  0.19, 0.19, 0.66, limbMat, unit.missing.rightArm);
    addBoneMesh('pelvis', 'lFoot',  0.22, 0.22, 0.74, limbMat, unit.missing.leftLeg);
    addBoneMesh('pelvis', 'rFoot',  0.22, 0.22, 0.74, limbMat, unit.missing.rightLeg);

    const rd = { nodes, links, visuals, group, isRobot: unit.isRobot, age: 0, settled: false, smearCd: 0 };
    ragdolls.push(rd);

    if (ragdolls.length > 16) {
      const old = ragdolls.shift();
      scene.remove(old.group);
    }
  }

  function stepRagdollsFixed() {
    const dt = 1 / 60;
    const grav = 25 * dt * dt;
    const drag = 0.988;

    for (let i = 0; i < ragdolls.length; i++) {
      const rd = ragdolls[i];
      if (rd.settled) continue;
      rd.age += dt;
      rd.smearCd -= dt;

      let totalSpeed = 0;
      const nodeList = Object.values(rd.nodes);

      // 1. Verlet integration + floor/wall collision
      for (let n = 0; n < nodeList.length; n++) {
        const p = nodeList[n];
        let vx = (p.x - p.ox) * drag;
        let vy = (p.y - p.oy) * drag;
        let vz = (p.z - p.oz) * drag;
        p.ox = p.x; p.oy = p.y; p.oz = p.z;
        p.x += vx; p.y += vy - grav; p.z += vz;

        // Floor bounce & blood smear
        if (p.y < p.r) {
          p.y = p.r;
          const horizSpd = Math.hypot(vx, vz);
          if (horizSpd > 0.08 && rd.smearCd <= 0) {
            rd.smearCd = 0.18;
            spawnDecal(new THREE.Vector3(p.x, 0.01, p.z), new THREE.Vector3(0, 1, 0), rd.isRobot ? 'oil' : 'blood', 0.95);
          }
          p.ox = p.x - vx * 0.62; // Floor friction
          p.oz = p.z - vz * 0.62;
          if (vy < -0.1) p.oy = p.y + vy * 0.25;
        }

        // Wall collision + Wall Blood Decal on heavy slam!
        for (let c = 0; c < colliders.length; c++) {
          const col = colliders[c];
          if (!col.alive || p.y > col.height + 0.1) continue;
          if (p.x > col.minX - p.r && p.x < col.maxX + p.r && p.z > col.minZ - p.r && p.z < col.maxZ + p.r) {
            const dl = Math.abs(p.x - (col.minX - p.r));
            const dr = Math.abs((col.maxX + p.r) - p.x);
            const dtz = Math.abs(p.z - (col.minZ - p.r));
            const dbz = Math.abs((col.maxZ + p.r) - p.z);
            const m = Math.min(dl, dr, dtz, dbz);
            const hitNorm = new THREE.Vector3();
            if (m === dl) { p.x = col.minX - p.r; hitNorm.set(-1, 0, 0); p.ox = p.x + vx * 0.4; }
            else if (m === dr) { p.x = col.maxX + p.r; hitNorm.set(1, 0, 0); p.ox = p.x + vx * 0.4; }
            else if (m === dtz) { p.z = col.minZ - p.r; hitNorm.set(0, 0, -1); p.oz = p.z + vz * 0.4; }
            else { p.z = col.maxZ + p.r; hitNorm.set(0, 0, 1); p.oz = p.z + vz * 0.4; }

            if (Math.hypot(vx, vz) > 0.14 && rd.smearCd <= 0) {
              rd.smearCd = 0.2;
              spawnDecal(new THREE.Vector3(p.x, p.y, p.z), hitNorm, rd.isRobot ? 'oil' : 'blood', 1.45);
              spawn3DParticles(new THREE.Vector3(p.x, p.y, p.z), rd.isRobot ? 'spark' : 'blood', 10, 4.5);
            }
          }
        }
        totalSpeed += Math.hypot(p.x - p.ox, p.y - p.oy, p.z - p.oz);
      }

      // 2. Iterative Stick Distance Constraint Solver (4 passes for crisp joints)
      for (let iter = 0; iter < 4; iter++) {
        for (let l = 0; l < rd.links.length; l++) {
          const [ka, kb, rest] = rd.links[l];
          const a = rd.nodes[ka], b = rd.nodes[kb];
          const dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
          const d = Math.hypot(dx, dy, dz) || 0.0001;
          const diff = (d - rest) / d * 0.5;
          a.x += dx * diff; a.y += dy * diff; a.z += dz * diff;
          b.x -= dx * diff; b.y -= dy * diff; b.z -= dz * diff;
          if (a.y < a.r) a.y = a.r;
          if (b.y < b.r) b.y = b.r;
        }
      }

      // 3. Sync 3D limb meshes between Verlet joint nodes
      const va = new THREE.Vector3(), vb = new THREE.Vector3(), mid = new THREE.Vector3();
      for (let v = 0; v < rd.visuals.length; v++) {
        const vis = rd.visuals[v];
        const a = rd.nodes[vis.a], b = rd.nodes[vis.b];
        va.set(a.x, a.y, a.z); vb.set(b.x, b.y, b.z);
        mid.addVectors(va, vb).multiplyScalar(0.5);
        vis.mesh.position.copy(mid);
        vis.mesh.lookAt(vb);
      }

      if (rd.age > 3.2 || (rd.age > 0.8 && totalSpeed < 0.03)) {
        rd.settled = true;
      }
    }
  }

  // =========================================================================
  // 7. 3D PARTICLES, EXPLOSIONS, DESTRUCTIBLES & ARTILLERY
  // =========================================================================
  function spawn3DParticles(pos, kind, count, speed = 6) {
    for (let i = 0; i < count; i++) {
      if (particles3D.length > 320) {
        const old = particles3D.shift();
        scene.remove(old.mesh);
      }
      let mat = MAT.bloodMat;
      let sz = 0.07 + Math.random() * 0.1;
      let grav = 18;
      let life = 0.45 + Math.random() * 0.45;
      if (kind === 'spark') { mat = MAT.sparkMat; sz = 0.05 + Math.random()*0.06; grav = 12; life = 0.25 + Math.random()*0.3; }
      else if (kind === 'fire') { mat = MAT.fireMat; sz = 0.22 + Math.random()*0.38; grav = -5; life = 0.3 + Math.random()*0.35; }
      else if (kind === 'smoke') { mat = MAT.smokeMat; sz = 0.45 + Math.random()*0.75; grav = -3.5; life = 0.7 + Math.random()*0.7; }
      else if (kind === 'concrete') { mat = MAT.concrete; sz = 0.1 + Math.random()*0.14; grav = 22; life = 0.6 + Math.random()*0.5; }

      const mesh = new THREE.Mesh(sharedBoxGeo, mat);
      mesh.scale.setScalar(sz);
      mesh.position.copy(pos);
      scene.add(mesh);

      const theta = Math.random() * Math.PI * 2;
      const phi = (Math.random() - 0.2) * Math.PI;
      const spd = (0.35 + Math.random() * 0.9) * speed;
      particles3D.push({
        mesh,
        vx: Math.cos(theta) * Math.cos(phi) * spd,
        vy: Math.abs(Math.sin(phi)) * spd + (kind === 'blood' ? 2.2 : 1.5),
        vz: Math.sin(theta) * Math.cos(phi) * spd,
        grav, life, maxLife: life, kind
      });
    }
  }

  function spawnTracer(p1, p2, colorHex, dur = 0.09) {
    const geo = new THREE.BufferGeometry().setFromPoints([p1, p2]);
    const mat = new THREE.LineBasicMaterial({ color: colorHex, transparent: true, opacity: 0.92 });
    const line = new THREE.Line(geo, mat);
    scene.add(line);
    tracerLines.push({ line, life: dur, maxLife: dur });
  }

  function destroyCrate(col, blastOrigin) {
    if (!col.destructible || !col.alive) return;
    col.alive = false;
    scene.remove(col.mesh);
    const idx = worldHitMeshes.indexOf(col.mesh);
    if (idx !== -1) worldHitMeshes.splice(idx, 1);

    const pos = col.mesh.position.clone();
    spawn3DParticles(pos, 'concrete', 18, 9);
    for (let i = 0; i < 6; i++) {
      const dir = pos.clone().sub(blastOrigin).normalize();
      spawnDetachedGib(pos, new THREE.Vector3(dir.x*7 + (Math.random()-0.5)*7, 4+Math.random()*6, dir.z*7 + (Math.random()-0.5)*7), new THREE.Vector3(0.35, 0.35, 0.2), MAT.crate, true, false);
    }
  }

  function triggerExplosion(pos, radius, maxDmg, srcFaction, srcName, isArtillery = false) {
    const dPlayer = pos.distanceTo(camera.position);
    const vol = Math.max(0.15, 1.15 - dPlayer / 65);
    SFX.playExplosion(vol, dPlayer < radius * 1.15);

    // Dynamic blast light + expanding shockwave sphere + scorch decal
    blastLight.position.set(pos.x, pos.y + 1.8, pos.z);
    blastLight.intensity = isArtillery ? 14 : 9;

    const sph = new THREE.Mesh(
      new THREE.SphereGeometry(1, 16, 12),
      new THREE.MeshBasicMaterial({ color: 0xff8833, transparent: true, opacity: 0.65, wireframe: false })
    );
    sph.position.copy(pos);
    scene.add(sph);
    shockSpheres.push({ mesh: sph, maxR: radius * 0.95, life: 0.28, maxLife: 0.28 });

    spawnDecal(new THREE.Vector3(pos.x, 0.02, pos.z), new THREE.Vector3(0, 1, 0), 'scorch', radius * 0.85);
    spawn3DParticles(pos, 'fire', 26, 11);
    spawn3DParticles(pos, 'smoke', 22, 7);
    spawn3DParticles(pos, 'spark', 28, 16);

    // Flying shrapnel chunks
    for (let i = 0; i < 12; i++) {
      const a = Math.random() * Math.PI * 2;
      const spd = 8 + Math.random() * 14;
      spawnDetachedGib(
        pos.clone().add(new THREE.Vector3(0, 0.6, 0)),
        new THREE.Vector3(Math.cos(a)*spd, 6 + Math.random()*10, Math.sin(a)*spd),
        new THREE.Vector3(0.22, 0.18, 0.3), MAT.darkIron, true, false
      );
    }

    // Screen Shake & Blast Flash
    if (dPlayer < 48) {
      const shakeAmt = Math.max(0.2, (1 - dPlayer / 48) * (isArtillery ? 1.5 : 1.05));
      state.shake = Math.max(state.shake, shakeAmt);
      if (dPlayer < radius * 1.4) {
        const bo = document.getElementById('blast-overlay');
        bo.style.opacity = '0.9';
        setTimeout(() => bo.style.opacity = '0', 180);
      }
    }

    // Shatter destructible crates
    for (let i = 0; i < colliders.length; i++) {
      const c = colliders[i];
      if (!c.destructible || !c.alive) continue;
      if (c.mesh.position.distanceTo(pos) < radius + 1.5) destroyCrate(c, pos);
    }

    // Chain-detonate nearby explosive red barrels!
    for (let i = 0; i < explosiveBarrels.length; i++) {
      const b = explosiveBarrels[i];
      if (!b.alive) continue;
      if (Math.hypot(b.x - pos.x, b.z - pos.z) < radius + 1.2) {
        b.alive = false;
        scene.remove(b.mesh);
        const wi = worldHitMeshes.indexOf(b.mesh);
        if (wi !== -1) worldHitMeshes.splice(wi, 1);
        setTimeout(() => triggerExplosion(new THREE.Vector3(b.x, 0.8, b.z), 9.5, 165, srcFaction, '폭발 드럼통', false), 110);
      }
    }

    // Blast all units into airborne RAGDOLLS + catastrophic dismemberment!
    for (let i = 0; i < units.length; i++) {
      const u = units[i];
      if (!u.alive) continue;
      const uPos = new THREE.Vector3(u.x, 1.0, u.z);
      const d = uPos.distanceTo(pos);
      if (d < radius + u.r) {
        const falloff = 1 - (d / (radius + u.r)) * 0.65;
        const dir = uPos.clone().sub(pos).normalize();
        const dmg = maxDmg * falloff;

        // Catastrophic dismemberment if near center!
        if (d < radius * 0.55 && !u.isBoss) {
          const candidates = ['leftArm', 'rightArm', 'head', 'leftLeg'];
          dismemberPart(u, candidates[Math.floor(Math.random()*candidates.length)], dir, 1.6);
        }

        const blastImpulse = dir.clone().multiplyScalar(15 + falloff * 18);
        blastImpulse.y = 7 + falloff * 10;
        damageUnit(u, dmg, 'torso', uPos, dir, srcFaction, srcName, isArtillery ? '포격 폭사' : '폭발 랙돌', blastImpulse);
      }
    }

    // Damage player if inside blast
    if (player.alive && dPlayer < radius) {
      const falloff = 1 - (dPlayer / radius) * 0.7;
      const dmg = (srcFaction === FACTION.PLAYER ? 32 : 58) * falloff;
      const dir = camera.position.clone().sub(pos).normalize();
      player.vx += dir.x * 12 * falloff;
      player.vy += 6 * falloff;
      player.vz += dir.z * 12 * falloff;
      damagePlayer(dmg, pos, srcName);
    }
  }

  function callArtilleryBarrage() {
    const alertEl = document.getElementById('artillery-alert');
    alertEl.style.opacity = '1';
    setTimeout(() => alertEl.style.opacity = '0', 3600);
    SFX.playArtilleryWhistle();

    const count = 2 + Math.min(2, Math.floor(state.wave / 2));
