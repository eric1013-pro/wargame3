    mesh.castShadow = true; mesh.receiveShadow = true;
    scene.add(mesh);
    worldHitMeshes.push(mesh);
    const barrel = { x, z, r: 0.6, mesh, hp: 32, alive: true };
    mesh.userData = { isWorld: true, barrel };
    explosiveBarrels.push(barrel);
  }

